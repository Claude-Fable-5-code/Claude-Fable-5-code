#!/usr/bin/env bash
# .governance/hooks/pre-commit — blocks commits containing secrets or machine-specific paths.
# Installed via: bash .governance/install_hooks.sh   (sets core.hooksPath=.governance/hooks)
set -u
ROOT="$(git rev-parse --show-toplevel)"
if [ -n "${PYTHON:-}" ]; then
  PY="$PYTHON"
elif command -v python >/dev/null 2>&1 && python -c "import sys; sys.exit(0 if sys.version_info >= (3, 7) else 1)" 2>/dev/null; then
  PY=python
elif command -v python3 >/dev/null 2>&1 && python3 -c "import sys; sys.exit(0 if sys.version_info >= (3, 7) else 1)" 2>/dev/null; then
  PY=python3
else
  PY=python
fi
rc=0
"$PY" "$ROOT/.governance/secret_scan.py" --staged --no-remote-check || rc=1
"$PY" "$ROOT/.governance/path_scan.py"   --staged                   || rc=1
# Round 14 (R93, Rule 37): no TODO/stub/placeholder/mock code may be committed. Opt-out per line: # mock-scan:allow
"$PY" "$ROOT/.governance/mock_scan.py"   --staged                   || rc=1
# Round 14 (R90, Rule 35): state moves with code. Any staged file ⇒ Root/ai_state.json must be staged,
# point at HEAD or HEAD~1, carry a next_action, and Root/PROGRESS.md must exist. Bypass: STATE_GATE_SKIP=1
# (allowed only for the commit that creates the state files themselves; the CI step has no bypass).
if [ "${STATE_GATE_SKIP:-0}" != "1" ]; then
  "$PY" "$ROOT/.governance/state_gate.py" verify --staged || rc=1
fi
if [ $rc -ne 0 ]; then
  echo
  echo "pre-commit: BLOCKED by .governance gate. Fix the lines above."
  echo "            (Bypassing with --no-verify is a §FATAL RULE violation and CI will still fail.)"
fi
exit $rc
